//@version=6
indicator("Volcanic Auto Peaks & Valleys v6", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- GRUPLAR / GROUPS ---
string GRP_AUTO = "⚓ Otomatik Çapa Ayarları / Auto Anchor Settings"
string GRP_M1   = "🚀 Motor 1 Ayarları / Engine 1 Settings"
string GRP_M2   = "🚀 Motor 2 Ayarları / Engine 2 Settings"
string GRP_VIS  = "🎨 Görsel Ayarlar / Visual Settings"
string GRP_TAB  = "📊 Tablo Ayarları / Table Settings"

// --- GİRDİLER / INPUTS ---
lb_mode        = input.string("Manuel", "Tarama Modu / Lookback Mode", options=["Manuel", "Otomatik (Hassasiyet)", "Global (Maksimum)", "Manuel (Tarih Seçimi)"], group=GRP_AUTO)
lb_sens        = input.int(1, "Otomatik Hassasiyet / Auto Sensitivity", minval=1, maxval=9, group=GRP_AUTO, tooltip="Otomatik modda ne kadar geriye bakılacağını ayarlar.")
auto_lookback  = input.int(81, "Manuel Tarama Mesafesi / Manual Lookback", minval=10, maxval=4990, group=GRP_AUTO)
auto_threshold = input.float(0.1, "Sabitleme Eşiği / Settle Threshold (x sz)", group=GRP_AUTO, tooltip="Fiyat filtreden bu kadar uzaklaşırsa çapa güncellenir.")
auto_prox_threshold = input.float(0.5, "Yaklaşma Eşiği / Proximity Threshold (%)", group=GRP_AUTO, tooltip="Fiyat filtreye bu kadar yaklaşırsa çapa güncellenir.")
p_time         = input.time(timestamp("2030-01-01"), "Tepe Çapa Zamanı / Peak Anchor Time", group=GRP_AUTO, confirm=true)
v_time         = input.time(timestamp("2030-01-01"), "Dip Çapa Zamanı / Valley Anchor Time", group=GRP_AUTO, confirm=true)

// --- MOTOR 1 GİRDİLERİ ---
show_m1          = input.bool(true, "Motor 1'i Aktifleştir / Enable Motor 1", group=GRP_M1)
p_gamma_val      = input.float(9.42477796076938, "Motor 1: Tepe Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M1)
v_gamma_val      = input.float(9.42477796076938, "Motor 1: Dip Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M1)
atr_mult         = input.float(3.1415926535897932, "Motor 1: ATR Çarpanı", options=[0.0000031415926535897932, 0.000031415926535897932, 0.00031415926535897932, 0.0031415926535897932, 0.031415926535897932, 0.31415926535897932, 3.1415926535897932, 31.415926535897932, 314.15926535897932, 3141.5926535897932], group=GRP_M1)
extra_layer_conn = input.string("ATR Çarpanı", "Motor 1: Ek Katman Bağlantısı", options=["ATR Çarpanı", "Gamma"], group=GRP_M1)

// --- MOTOR 2 GİRDİLERİ ---
show_m2          = input.bool(true, "Motor 2'yi Aktifleştir / Enable Motor 2", group=GRP_M2)
p_gamma_val_2      = input.float(9.42477796076938, "Motor 2: Tepe Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M2)
v_gamma_val_2      = input.float(9.42477796076938, "Motor 2: Dip Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M2)
atr_mult_2         = input.float(31.415926535897932, "Motor 2: ATR Çarpanı", options=[0.0000031415926535897932, 0.000031415926535897932, 0.00031415926535897932, 0.0031415926535897932, 0.031415926535897932, 0.31415926535897932, 3.1415926535897932, 31.415926535897932, 314.15926535897932, 3141.5926535897932], group=GRP_M2)
extra_layer_conn_2 = input.string("ATR Çarpanı", "Motor 2: Ek Katman Bağlantısı", options=["ATR Çarpanı", "Gamma"], group=GRP_M2)

// --- ORTAK GÖRSEL AYARLAR ---
auto_atr       = input.bool(true, "Otomatik ATR Periyodu / Auto ATR Period", group=GRP_VIS)
atr_opt        = input.float(8.1, "Manuel ATR Periyodu / Manual ATR Period", minval=0.01, maxval=4990.0, step=0.1, group=GRP_VIS)
show_peak      = input.bool(true, "Tepe Filtresini Göster / Show Peak Filter", group=GRP_VIS)
show_valley    = input.bool(true, "Dip Filtresini Göster / Show Valley Filter", group=GRP_VIS)
use_ha         = input.bool(false, "Heikin Ashi Hesaplaması Kullan / Use Heikin Ashi Calculation", group=GRP_VIS)
filt_width     = input.int(2, "Çizgi Kalınlığı / Line Width", minval=1, maxval=5, group=GRP_VIS)

show_table     = input.bool(true, "Bilgi Tablosunu Göster / Show Info Table", group=GRP_TAB)
table_pos      = input.string("Top Right", "Tablo Konumu / Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=GRP_TAB)

// --- YARDIMCI FONKSİYONLAR / HELPERS ---
f_kama_atr(float src, float n) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.floor(n_eff))
    float frac = n_eff - n_i
    
    // Volatility calculation without a loop
    // Note: ta.sma must be called on every bar to maintain buffers
    float v_diff = math.abs(src - nz(src[1], src))
    int length = math.max(1, n_i)
    float vol_sum = ta.sma(v_diff, length) * length
    
    float vol = vol_sum
    if frac > 0
        vol := vol + math.abs(nz(src[n_i], src) - nz(src[n_i+1], src)) * frac
    
    // Direction calculation with interpolation
    float val_n = n_i == 0 ? src : (frac == 0 ? nz(src[n_i], src) : nz(src[n_i], src) * (1.0 - frac) + nz(src[n_i+1], src) * frac)
    float dir = math.abs(src - val_n)
    
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    
    // Adaptive smoothing limits to allow "faster" response for small n
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    
    // For periods below 1, scale the resulting value to represent fractional range
    n < 1.0 ? kama * n : kama

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

// --- HESAPLAMA AKIŞI / CALCULATION FLOW ---
// Heikin Ashi Calculation
var float haOpen = na
haClose = (open + high + low + close) / 4
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

eff_h  = use_ha ? haHigh : high
eff_l  = use_ha ? haLow  : low
eff_c  = use_ha ? haClose : close
float tr = use_ha ? math.max(haHigh - haLow, math.max(math.abs(haHigh - haClose[1]), math.abs(haLow - haClose[1]))) : ta.tr(true)

int lb_input_val = lb_mode == "Global (Maksimum)" ? 4990 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 144 : auto_lookback

// Calculation of is_in_range without last_bar_index dependency
// Using timenow to estimate the current bar position relative to history
bool is_in_range = (lb_mode == "Global (Maksimum)") or 
                  (lb_mode == "Manuel (Tarih Seçimi)") or
                  (timenow - time < (lb_input_val + 500) * timeframe.in_seconds() * 1000)

// Engine 1 Parameters
float atr_per_1 = math.min(4990.0, auto_atr ? (timeframe.in_seconds() / 60.0) * atr_mult : atr_opt)
float cur_sz_unit_1_raw = f_kama_atr(tr, nz(atr_per_1, 8.1))
float cur_sz_unit_1 = is_in_range ? cur_sz_unit_1_raw : 0.0

float atr_mult_ex_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex_1 := na

float atr_per_ex_1 = not na(atr_mult_ex_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex_1) : na
float cur_sz_unit_ex_1_raw = f_kama_atr(tr, nz(atr_per_ex_1, 8.1))
float cur_sz_unit_ex_1 = is_in_range and not na(atr_per_ex_1) ? cur_sz_unit_ex_1_raw : na

// Motor 1: 2nd Extra Peak Parameters
float atr_mult_ex2_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 100.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex2_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex2_1 := na
float atr_per_ex2_1 = not na(atr_mult_ex2_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex2_1) : na
float cur_sz_unit_ex2_1_raw = f_kama_atr(tr, nz(atr_per_ex2_1, 8.1))
float cur_sz_unit_ex2_1 = is_in_range and not na(atr_per_ex2_1) ? cur_sz_unit_ex2_1_raw : na

// Motor 1: 3rd Extra Peak Parameters
float atr_mult_ex3_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 1000.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex3_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex3_1 := na
float atr_per_ex3_1 = not na(atr_mult_ex3_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex3_1) : na
float cur_sz_unit_ex3_1_raw = f_kama_atr(tr, nz(atr_per_ex3_1, 8.1))
float cur_sz_unit_ex3_1 = is_in_range and not na(atr_per_ex3_1) ? cur_sz_unit_ex3_1_raw : na

float p_gamma_ex_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 1.5707963267948966 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex_1 > 141.3716694115407 + 0.1)
    p_gamma_ex_1 := na
float p_gamma_ex2_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 3.1415926535897932 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex2_1 > 141.3716694115407 + 0.1)
    p_gamma_ex2_1 := na
float p_gamma_ex3_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 4.71238898038469 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex3_1 > 141.3716694115407 + 0.1)
    p_gamma_ex3_1 := na
float v_gamma_ex_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 1.5707963267948966 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex_1 > 141.3716694115407 + 0.1)
    v_gamma_ex_1 := na
float v_gamma_ex2_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 3.1415926535897932 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex2_1 > 141.3716694115407 + 0.1)
    v_gamma_ex2_1 := na
float v_gamma_ex3_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 4.71238898038469 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex3_1 > 141.3716694115407 + 0.1)
    v_gamma_ex3_1 := na

// Engine 2 Parameters
float atr_per_2 = math.min(4990.0, auto_atr ? (timeframe.in_seconds() / 60.0) * atr_mult_2 : atr_opt)
float cur_sz_unit_2_raw = f_kama_atr(tr, nz(atr_per_2, 8.1))
float cur_sz_unit_2 = is_in_range ? cur_sz_unit_2_raw : 0.0

float atr_mult_ex_2 = extra_layer_conn_2 == "ATR Çarpanı" ? atr_mult_2 * 10.0 : atr_mult_2
if extra_layer_conn_2 == "ATR Çarpanı" and (atr_mult_ex_2 > 3141.5926535897932 + 1.0)
    atr_mult_ex_2 := na

float atr_per_ex_2 = not na(atr_mult_ex_2) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex_2) : na
float cur_sz_unit_ex_2_raw = f_kama_atr(tr, nz(atr_per_ex_2, 8.1))
float cur_sz_unit_ex_2 = is_in_range and not na(atr_per_ex_2) ? cur_sz_unit_ex_2_raw : na

float p_gamma_ex_2 = extra_layer_conn_2 == "Gamma" ? p_gamma_val_2 + 1.5707963267948966 : p_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (p_gamma_ex_2 > 141.3716694115407 + 0.1)
    p_gamma_ex_2 := na
float v_gamma_ex_2 = extra_layer_conn_2 == "Gamma" ? v_gamma_val_2 + 1.5707963267948966 : v_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (v_gamma_ex_2 > 141.3716694115407 + 0.1)
    v_gamma_ex_2 := na

max_bars_back(cur_sz_unit_1, 5000)
max_bars_back(cur_sz_unit_ex_1, 5000)
max_bars_back(cur_sz_unit_ex2_1, 5000)
float cur_sz_unit_ex2_v1_raw = f_kama_atr(tr, nz(atr_per_ex2_1, 8.1))
float cur_sz_unit_ex2_v1 = is_in_range and not na(atr_per_ex2_1) ? cur_sz_unit_ex2_v1_raw : na
max_bars_back(cur_sz_unit_ex2_v1, 5000)
max_bars_back(cur_sz_unit_ex3_1, 5000)
max_bars_back(cur_sz_unit_2, 5000)
max_bars_back(cur_sz_unit_ex_2, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)
max_bars_back(eff_h, 5000)
max_bars_back(eff_l, 5000)
max_bars_back(eff_c, 5000)

// 3. Anchor & Lookback State (Shared)
int lb_input = lb_input_val
int eff_lb = math.min(math.max(1, lb_input), bar_index + 1)
f_dyn_hb(src, len) => ta.highestbars(src, math.min(len, bar_index + 1))
f_dyn_lb(src, len) => ta.lowestbars(src, math.min(len, bar_index + 1))

hb_4990 = f_dyn_hb(eff_h, 4990), lb_4990 = f_dyn_lb(eff_l, 4990)
hb_auto = f_dyn_hb(eff_h, lb_input), lb_auto = f_dyn_lb(eff_l, lb_input)

// Final Sizes for Engines
float cur_p_sz_1 = cur_sz_unit_1 * p_gamma_val
float cur_v_sz_1 = cur_sz_unit_1 * v_gamma_val
float cur_p_sz_2 = cur_sz_unit_2 * p_gamma_val_2
float cur_v_sz_2 = cur_sz_unit_2 * v_gamma_val_2

// Anchor Indices (Shared)
var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p_1 = na
var float last_f_v_1 = na

f_get_settled_idx(bool is_peak, int lb_mode_idx, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, float c_src, int hb_49, int lb_49, int hb_a, int lb_a) =>
    int off = lb_mode_idx == 0 ? (is_peak ? hb_49 : lb_49) : (is_peak ? hb_a : lb_a)
    int raw_ext_idx = bar_index + off
    int res_idx = prev_settled
    if na(prev_settled) or (bar_index - prev_settled > lb_val)
        res_idx := raw_ext_idx
    else
        float dist_pct = not na(prev_f) ? math.abs(c_src - prev_f) / prev_f * 100 : na
        bool prox_reset = not na(dist_pct) and dist_pct <= auto_prox_threshold
        bool threshold_reset = not na(prev_f) and not na(sz_val) and math.abs(c_src - prev_f) > auto_threshold * sz_val
        if prox_reset or threshold_reset
            res_idx := raw_ext_idx
    res_idx

int lb_mode_idx = lb_mode == "Global (Maksimum)" ? 0 : 1
if is_in_range
    settled_p_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(true, lb_mode_idx, lb_input, last_f_p_1, cur_p_sz_1, settled_p_idx, eff_h, eff_l, eff_c, hb_4990, lb_4990, hb_auto, lb_auto)
    settled_v_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(false, lb_mode_idx, lb_input, last_f_v_1, cur_v_sz_1, settled_v_idx, eff_h, eff_l, eff_c, hb_4990, lb_4990, hb_auto, lb_auto)

if lb_mode == "Manuel (Tarih Seçimi)"
    settled_p_idx := ta.valuewhen(time <= p_time, bar_index, 0)
    settled_v_idx := ta.valuewhen(time <= v_time, bar_index, 0)

// 7. Filter States (8 Total)
var FiltState fs_p1 = FiltState.new(), fs_v1 = FiltState.new()
var FiltState fs_p1_ex = FiltState.new(), fs_v1_ex = FiltState.new()
var FiltState fs_p2 = FiltState.new(), fs_v2 = FiltState.new()
var FiltState fs_p2_ex = FiltState.new(), fs_v2_ex = FiltState.new()

is_p_anc = (bar_index == settled_p_idx) or (ta.change(settled_p_idx) != 0)
is_v_anc = (bar_index == settled_v_idx) or (ta.change(settled_v_idx) != 0)
float init_p_val = eff_h[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
float init_v_val = eff_l[math.max(0, bar_index - nz(settled_v_idx, bar_index))]

last_f_p_1 := fs_p1.upd_filt(eff_h, eff_l, cur_p_sz_1, init_p_val, is_p_anc)
last_f_v_1 := fs_v1.upd_filt(eff_h, eff_l, cur_v_sz_1, init_v_val, is_v_anc)

float cur_p_sz_ex_1 = not na(cur_sz_unit_ex_1) and not na(p_gamma_ex_1) ? cur_sz_unit_ex_1 * p_gamma_ex_1 : na
float cur_v_sz_ex_1 = not na(cur_sz_unit_ex_1) and not na(v_gamma_ex_1) ? cur_sz_unit_ex_1 * v_gamma_ex_1 : na
float last_f_p1_ex = not na(cur_p_sz_ex_1) ? fs_p1_ex.upd_filt(eff_h, eff_l, cur_p_sz_ex_1, init_p_val, is_p_anc) : na
float last_f_v1_ex = not na(cur_v_sz_ex_1) ? fs_v1_ex.upd_filt(eff_h, eff_l, cur_v_sz_ex_1, init_v_val, is_v_anc) : na

float last_f_p_2 = fs_p2.upd_filt(eff_h, eff_l, cur_p_sz_2, init_p_val, is_p_anc)
float last_f_v_2 = fs_v2.upd_filt(eff_h, eff_l, cur_v_sz_2, init_v_val, is_v_anc)

float cur_p_sz_ex_2 = not na(cur_sz_unit_ex_2) and not na(p_gamma_ex_2) ? cur_sz_unit_ex_2 * p_gamma_ex_2 : na
float cur_v_sz_ex_2 = not na(cur_sz_unit_ex_2) and not na(v_gamma_ex_2) ? cur_sz_unit_ex_2 * v_gamma_ex_2 : na
float last_f_p2_ex = not na(cur_p_sz_ex_2) ? fs_p2_ex.upd_filt(eff_h, eff_l, cur_p_sz_ex_2, init_p_val, is_p_anc) : na
float last_f_v2_ex = not na(cur_v_sz_ex_2) ? fs_v2_ex.upd_filt(eff_h, eff_l, cur_v_sz_ex_2, init_v_val, is_v_anc) : na

// Visualization
var polyline[] p_pl = array.new<polyline>(0)
var polyline[] v_pl = array.new<polyline>(0)

if barstate.islast
    for pl in p_pl
        polyline.delete(pl)
    for pl in v_pl
        polyline.delete(pl)
    array.clear(p_pl), array.clear(v_pl)
    
    int p_idx_u = settled_p_idx
    int v_idx_u = settled_v_idx

    // --- DRAW ENGINE 1 ---
    if show_m1 and show_peak and not na(p_idx_u)
        // Main
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4990, p_idx_u)
        float st = eff_h[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_1[off] * p_gamma_val, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(p_pl, polyline.new(pts, line_color=color.yellow, line_width=filt_width))
        // Extra
        if not na(p_gamma_ex_1) and not na(cur_sz_unit_ex_1)
            FiltState f_re = FiltState.new()
            chart.point[] ptse = array.new<chart.point>(0)
            float cfe = na, float pfe = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe := f_re.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex_1[off] * p_gamma_ex_1, st, j == s_idx)
                if not na(pfe) and math.abs(pfe - cfe) > (syminfo.mintick / 10)
                    array.push(ptse, chart.point.from_index(j, pfe))
                array.push(ptse, chart.point.from_index(j, cfe))
                pfe := cfe
            if array.size(ptse) > 1
                array.push(p_pl, polyline.new(ptse, line_color=color.red, line_width=filt_width))
        // 2nd Extra (Motor 1 Only)
        if not na(p_gamma_ex2_1) and not na(cur_sz_unit_ex2_1)
            FiltState f_re2 = FiltState.new()
            chart.point[] ptse2 = array.new<chart.point>(0)
            float cfe2 = na, float pfe2 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe2 := f_re2.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex2_1[off] * p_gamma_ex2_1, st, j == s_idx)
                if not na(pfe2) and math.abs(pfe2 - cfe2) > (syminfo.mintick / 10)
                    array.push(ptse2, chart.point.from_index(j, pfe2))
                array.push(ptse2, chart.point.from_index(j, cfe2))
                pfe2 := cfe2
            if array.size(ptse2) > 1
                array.push(p_pl, polyline.new(ptse2, line_color=color.red, line_width=filt_width))
        // 3rd Extra (Motor 1 Only)
        if not na(p_gamma_ex3_1) and not na(cur_sz_unit_ex3_1)
            FiltState f_re3 = FiltState.new()
            chart.point[] ptse3 = array.new<chart.point>(0)
            float cfe3 = na, float pfe3 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe3 := f_re3.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex3_1[off] * p_gamma_ex3_1, st, j == s_idx)
                if not na(pfe3) and math.abs(pfe3 - cfe3) > (syminfo.mintick / 10)
                    array.push(ptse3, chart.point.from_index(j, pfe3))
                array.push(ptse3, chart.point.from_index(j, cfe3))
                pfe3 := cfe3
            if array.size(ptse3) > 1
                array.push(p_pl, polyline.new(ptse3, line_color=color.red, line_width=filt_width))

    if show_m1 and show_valley and not na(v_idx_u)
        // Main
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4990, v_idx_u)
        float st = eff_l[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_1[off] * v_gamma_val, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(v_pl, polyline.new(pts, line_color=color.yellow, line_width=filt_width))
        // Extra
        if not na(v_gamma_ex_1) and not na(cur_sz_unit_ex_1)
            FiltState f_re = FiltState.new()
            chart.point[] ptse = array.new<chart.point>(0)
            float cfe = na, float pfe = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe := f_re.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex_1[off] * v_gamma_ex_1, st, j == s_idx)
                if not na(pfe) and math.abs(pfe - cfe) > (syminfo.mintick / 10)
                    array.push(ptse, chart.point.from_index(j, pfe))
                array.push(ptse, chart.point.from_index(j, cfe))
                pfe := cfe
            if array.size(ptse) > 1
                array.push(v_pl, polyline.new(ptse, line_color=color.green, line_width=filt_width))
        // 2nd Extra (Motor 1 Only)
        if not na(v_gamma_ex2_1) and not na(cur_sz_unit_ex2_v1)
            FiltState f_re2 = FiltState.new()
            chart.point[] ptse2 = array.new<chart.point>(0)
            float cfe2 = na, float pfe2 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe2 := f_re2.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex2_v1[off] * v_gamma_ex2_1, st, j == s_idx)
                if not na(pfe2) and math.abs(pfe2 - cfe2) > (syminfo.mintick / 10)
                    array.push(ptse2, chart.point.from_index(j, pfe2))
                array.push(ptse2, chart.point.from_index(j, cfe2))
                pfe2 := cfe2
            if array.size(ptse2) > 1
                array.push(v_pl, polyline.new(ptse2, line_color=color.green, line_width=filt_width))
        // 3rd Extra (Motor 1 Only)
        if not na(v_gamma_ex3_1) and not na(cur_sz_unit_ex3_1)
            FiltState f_re3 = FiltState.new()
            chart.point[] ptse3 = array.new<chart.point>(0)
            float cfe3 = na, float pfe3 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe3 := f_re3.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex3_1[off] * v_gamma_ex3_1, st, j == s_idx)
                if not na(pfe3) and math.abs(pfe3 - cfe3) > (syminfo.mintick / 10)
                    array.push(ptse3, chart.point.from_index(j, pfe3))
                array.push(ptse3, chart.point.from_index(j, cfe3))
                pfe3 := cfe3
            if array.size(ptse3) > 1
                array.push(v_pl, polyline.new(ptse3, line_color=color.green, line_width=filt_width))

    // --- DRAW ENGINE 2 ---
    if show_m2 and show_peak and not na(p_idx_u)
        // Main
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4990, p_idx_u)
        float st = eff_h[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_2[off] * p_gamma_val_2, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(p_pl, polyline.new(pts, line_color=color.yellow, line_width=filt_width))
        // Extra
        if not na(p_gamma_ex_2) and not na(cur_sz_unit_ex_2)
            FiltState f_re = FiltState.new()
            chart.point[] ptse = array.new<chart.point>(0)
            float cfe = na, float pfe = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe := f_re.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex_2[off] * p_gamma_ex_2, st, j == s_idx)
                if not na(pfe) and math.abs(pfe - cfe) > (syminfo.mintick / 10)
                    array.push(ptse, chart.point.from_index(j, pfe))
                array.push(ptse, chart.point.from_index(j, cfe))
                pfe := cfe
            if array.size(ptse) > 1
                array.push(p_pl, polyline.new(ptse, line_color=color.red, line_width=filt_width))

    if show_m2 and show_valley and not na(v_idx_u)
        // Main
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4990, v_idx_u)
        float st = eff_l[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_2[off] * v_gamma_val_2, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(v_pl, polyline.new(pts, line_color=color.yellow, line_width=filt_width))
        // Extra
        if not na(v_gamma_ex_2) and not na(cur_sz_unit_ex_2)
            FiltState f_re = FiltState.new()
            chart.point[] ptse = array.new<chart.point>(0)
            float cfe = na, float pfe = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe := f_re.upd_filt(eff_h[off], eff_l[off], cur_sz_unit_ex_2[off] * v_gamma_ex_2, st, j == s_idx)
                if not na(pfe) and math.abs(pfe - cfe) > (syminfo.mintick / 10)
                    array.push(ptse, chart.point.from_index(j, pfe))
                array.push(ptse, chart.point.from_index(j, cfe))
                pfe := cfe
            if array.size(ptse) > 1
                array.push(v_pl, polyline.new(ptse, line_color=color.green, line_width=filt_width))

// Table
if show_table and barstate.islast
    pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    int cols = 1 + (show_m1 ? 1 : 0) + (show_m2 ? 1 : 0)
    var table info_tab = table.new(pos, cols, 7, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    c_bg = color.new(color.gray, 80), c_txt = color.white
    
    table.cell(info_tab, 0, 0, "💎 Volcanic Dual", bgcolor=color.new(color.black, 40), text_color=color.yellow)
    table.cell(info_tab, 0, 1, "Tepe Gamma", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 2, "Dip Gamma", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 3, "ATR Çarpanı", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 4, "Hesaplanan ATR Per.", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 5, "Ek Katman Bağ.", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 6, "Durum", bgcolor=c_bg, text_color=c_txt)

    int cur_col = 1
    if show_m1
        table.cell(info_tab, cur_col, 0, "Motor 1", bgcolor=color.new(color.black, 40), text_color=color.white)
        table.cell(info_tab, cur_col, 1, str.tostring(p_gamma_val, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 2, str.tostring(v_gamma_val, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 3, str.tostring(atr_mult, "#.#####"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 4, str.tostring(atr_per_1, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 5, extra_layer_conn, bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 6, "Aktif", bgcolor=color.new(color.green, 70), text_color=c_txt)
        cur_col := cur_col + 1
    
    if show_m2
        table.cell(info_tab, cur_col, 0, "Motor 2", bgcolor=color.new(color.black, 40), text_color=color.white)
        table.cell(info_tab, cur_col, 1, str.tostring(p_gamma_val_2, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 2, str.tostring(v_gamma_val_2, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 3, str.tostring(atr_mult_2, "#.#####"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 4, str.tostring(atr_per_2, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 5, extra_layer_conn_2, bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 6, "Aktif", bgcolor=color.new(color.green, 70), text_color=c_txt)

// Labels (Shared)
var label lp = na, var label lv = na
if barstate.islast
    int p_idx_label = settled_p_idx, int v_idx_label = settled_v_idx
    if not na(p_idx_label)
        int h_off = math.max(0, math.min(4999, bar_index - p_idx_label))
        if na(lp)
            lp := label.new(p_idx_label, eff_h[h_off], "⚓ Tepe", color=color.red, textcolor=color.white, style=label.style_label_down)
        else
            label.set_xy(lp, p_idx_label, eff_h[h_off])
    if not na(v_idx_label)
        int v_off = math.max(0, math.min(4999, bar_index - v_idx_label))
        if na(lv)
            lv := label.new(v_idx_label, eff_l[v_off], "⚓ Dip", color=color.green, textcolor=color.white, style=label.style_label_up)
        else
            label.set_xy(lv, v_idx_label, eff_l[v_off])
