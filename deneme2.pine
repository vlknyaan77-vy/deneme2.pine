            array.push(v_pl, polyline.new(pts2, line_color=m1_c_g, line_width=filt_width))
        if array.size(pts3) > 1
            array.push(v_pl, polyline.new(pts3, line_color=m1_c_g, line_width=filt_width))
        if array.size(pts4) > 1
            array.push(v_pl, polyline.new(pts4, line_color=m1_c_g, line_width=filt_width))
        if array.size(pts5) > 1
            array.push(v_pl, polyline.new(pts5, line_color=m1_c_g, line_width=filt_width))
        if array.size(pts6) > 1
            array.push(v_pl, polyline.new(pts6, line_color=m1_c_g, line_width=filt_width))
        if array.size(pts7) > 1
            array.push(v_pl, polyline.new(pts7, line_color=m1_c_g, line_width=filt_width))

    // --- DRAW ENGINE 2 ---
    if show_m2 and show_peak and not na(p_idx_u)
        // Main
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4990, p_idx_u)
        float st = eff_h_m2[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_2[off] * p_gamma_val_2, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(p_pl, polyline.new(pts, line_color=m2_c_y, line_width=filt_width))
        // Extra
        if not na(p_gamma_ex_2) and not na(cur_sz_unit_ex_2)
            FiltState f_re = FiltState.new()
            chart.point[] ptse = array.new<chart.point>(0)
            float cfe = na, float pfe = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe := f_re.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex_2[off] * p_gamma_ex_2, st, j == s_idx)
                if not na(pfe) and math.abs(pfe - cfe) > (syminfo.mintick / 10)
                    array.push(ptse, chart.point.from_index(j, pfe))
                array.push(ptse, chart.point.from_index(j, cfe))
                pfe := cfe
            if array.size(ptse) > 1
                array.push(p_pl, polyline.new(ptse, line_color=m2_c_r, line_width=filt_width))
        // 2nd Extra (Motor 2)
        if not na(p_gamma_ex2_2) and not na(cur_sz_unit_ex2_2)
            FiltState f_re2 = FiltState.new()
            chart.point[] ptse2 = array.new<chart.point>(0)
            float cfe2 = na, float pfe2 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe2 := f_re2.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex2_2[off] * p_gamma_ex2_2, st, j == s_idx)
                if not na(pfe2) and math.abs(pfe2 - cfe2) > (syminfo.mintick / 10)
                    array.push(ptse2, chart.point.from_index(j, pfe2))
                array.push(ptse2, chart.point.from_index(j, cfe2))
                pfe2 := cfe2
            if array.size(ptse2) > 1
                array.push(p_pl, polyline.new(ptse2, line_color=m2_c_r, line_width=filt_width))
        // 3rd Extra (Motor 2)
        if not na(p_gamma_ex3_2) and not na(cur_sz_unit_ex3_2)
            FiltState f_re3 = FiltState.new()
            chart.point[] ptse3 = array.new<chart.point>(0)
            float cfe3 = na, float pfe3 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe3 := f_re3.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex3_2[off] * p_gamma_ex3_2, st, j == s_idx)
                if not na(pfe3) and math.abs(pfe3 - cfe3) > (syminfo.mintick / 10)
                    array.push(ptse3, chart.point.from_index(j, pfe3))
                array.push(ptse3, chart.point.from_index(j, cfe3))
                pfe3 := cfe3
            if array.size(ptse3) > 1
                array.push(p_pl, polyline.new(ptse3, line_color=m2_c_r, line_width=filt_width))
        // 4th Extra (Motor 2)
        if not na(p_gamma_ex4_2) and not na(cur_sz_unit_ex4_2)
            FiltState f_re4 = FiltState.new()
            chart.point[] ptse4 = array.new<chart.point>(0)
            float cfe4 = na, float pfe4 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe4 := f_re4.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex4_2[off] * p_gamma_ex4_2, st, j == s_idx)
                if not na(pfe4) and math.abs(pfe4 - cfe4) > (syminfo.mintick / 10)
                    array.push(ptse4, chart.point.from_index(j, pfe4))
                array.push(ptse4, chart.point.from_index(j, cfe4))
                pfe4 := cfe4
            if array.size(ptse4) > 1
                array.push(p_pl, polyline.new(ptse4, line_color=m2_c_r, line_width=filt_width))
        // 5th Extra (Motor 2)
        if not na(p_gamma_ex5_2) and not na(cur_sz_unit_ex5_2)
            FiltState f_re5 = FiltState.new()
            chart.point[] ptse5 = array.new<chart.point>(0)
            float cfe5 = na, float pfe5 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe5 := f_re5.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex5_2[off] * p_gamma_ex5_2, st, j == s_idx)
                if not na(pfe5) and math.abs(pfe5 - cfe5) > (syminfo.mintick / 10)
                    array.push(ptse5, chart.point.from_index(j, pfe5))
                array.push(ptse5, chart.point.from_index(j, cfe5))
                pfe5 := cfe5
            if array.size(ptse5) > 1
                array.push(p_pl, polyline.new(ptse5, line_color=m2_c_r, line_width=filt_width))

    if show_m2 and show_valley and not na(v_idx_u)
        // Main
        FiltState f_r = FiltState.new()
        chart.point[] pts = array.new<chart.point>(0)
        float cf = na, float pf = na
        int s_idx = math.max(bar_index - 4990, v_idx_u)
        float st = eff_l_m2[bar_index-s_idx]
        for j = s_idx to bar_index
            off = bar_index - j
            cf := f_r.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_2[off] * v_gamma_val_2, st, j == s_idx)
            if not na(pf) and math.abs(pf - cf) > (syminfo.mintick / 10)
                array.push(pts, chart.point.from_index(j, pf))
            array.push(pts, chart.point.from_index(j, cf))
            pf := cf
        if array.size(pts) > 1
            array.push(v_pl, polyline.new(pts, line_color=m2_c_y, line_width=filt_width))
        // Extra
        if not na(v_gamma_ex_2) and not na(cur_sz_unit_ex_2)
            FiltState f_re = FiltState.new()
            chart.point[] ptse = array.new<chart.point>(0)
            float cfe = na, float pfe = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe := f_re.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex_2[off] * v_gamma_ex_2, st, j == s_idx)
                if not na(pfe) and math.abs(pfe - cfe) > (syminfo.mintick / 10)
                    array.push(ptse, chart.point.from_index(j, pfe))
                array.push(ptse, chart.point.from_index(j, cfe))
                pfe := cfe
            if array.size(ptse) > 1
                array.push(v_pl, polyline.new(ptse, line_color=m2_c_g, line_width=filt_width))
        // 2nd Extra (Motor 2)
        if not na(v_gamma_ex2_2) and not na(cur_sz_unit_ex2_2)
            FiltState f_re2 = FiltState.new()
            chart.point[] ptse2 = array.new<chart.point>(0)
            float cfe2 = na, float pfe2 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe2 := f_re2.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex2_2[off] * v_gamma_ex2_2, st, j == s_idx)
                if not na(pfe2) and math.abs(pfe2 - cfe2) > (syminfo.mintick / 10)
                    array.push(ptse2, chart.point.from_index(j, pfe2))
                array.push(ptse2, chart.point.from_index(j, cfe2))
                pfe2 := cfe2
            if array.size(ptse2) > 1
                array.push(v_pl, polyline.new(ptse2, line_color=m2_c_g, line_width=filt_width))
        // 3rd Extra (Motor 2)
        if not na(v_gamma_ex3_2) and not na(cur_sz_unit_ex3_2)
            FiltState f_re3 = FiltState.new()
            chart.point[] ptse3 = array.new<chart.point>(0)
            float cfe3 = na, float pfe3 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe3 := f_re3.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex3_2[off] * v_gamma_ex3_2, st, j == s_idx)
                if not na(pfe3) and math.abs(pfe3 - cfe3) > (syminfo.mintick / 10)
                    array.push(ptse3, chart.point.from_index(j, pfe3))
                array.push(ptse3, chart.point.from_index(j, cfe3))
                pfe3 := cfe3
            if array.size(ptse3) > 1
                array.push(v_pl, polyline.new(ptse3, line_color=m2_c_g, line_width=filt_width))
        // 4th Extra (Motor 2)
        if not na(v_gamma_ex4_2) and not na(cur_sz_unit_ex4_2)
            FiltState f_re4 = FiltState.new()
            chart.point[] ptse4 = array.new<chart.point>(0)
            float cfe4 = na, float pfe4 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe4 := f_re4.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex4_2[off] * v_gamma_ex4_2, st, j == s_idx)
                if not na(pfe4) and math.abs(pfe4 - cfe4) > (syminfo.mintick / 10)
                    array.push(ptse4, chart.point.from_index(j, pfe4))
                array.push(ptse4, chart.point.from_index(j, cfe4))
                pfe4 := cfe4
            if array.size(ptse4) > 1
                array.push(v_pl, polyline.new(ptse4, line_color=m2_c_g, line_width=filt_width))
        // 5th Extra (Motor 2)
        if not na(v_gamma_ex5_2) and not na(cur_sz_unit_ex5_2)
            FiltState f_re5 = FiltState.new()
            chart.point[] ptse5 = array.new<chart.point>(0)
            float cfe5 = na, float pfe5 = na
            for j = s_idx to bar_index
                off = bar_index - j
                cfe5 := f_re5.upd_filt(eff_h_m2[off], eff_l_m2[off], cur_sz_unit_ex5_2[off] * v_gamma_ex5_2, st, j == s_idx)
                if not na(pfe5) and math.abs(pfe5 - cfe5) > (syminfo.mintick / 10)
                    array.push(ptse5, chart.point.from_index(j, pfe5))
                array.push(ptse5, chart.point.from_index(j, cfe5))
                pfe5 := cfe5
            if array.size(ptse5) > 1
                array.push(v_pl, polyline.new(ptse5, line_color=m2_c_g, line_width=filt_width))

// Table
if show_table and barstate.islast
    pos = table_pos == "Top Right" ? position.top_right : table_pos == "Bottom Right" ? position.bottom_right : table_pos == "Top Left" ? position.top_left : table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    int cols = 1 + (show_m1 ? 1 : 0) + (show_m2 ? 1 : 0)
    var table info_tab = table.new(pos, cols, 7, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    c_bg = color.new(color.gray, 80), c_txt = color.white
    
    table.cell(info_tab, 0, 0, "💎 Volcanic Dual", bgcolor=color.new(color.black, 40), text_color=color.yellow)
    table.cell(info_tab, 0, 1, "Tepe Gamma", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 2, "Dip Gamma", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 3, "ATR Çarpanı", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 4, "Hesaplanan ATR Per.", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 5, "Ek Katman Bağ.", bgcolor=c_bg, text_color=c_txt)
    table.cell(info_tab, 0, 6, "Durum", bgcolor=c_bg, text_color=c_txt)

    int cur_col = 1
    if show_m1
        table.cell(info_tab, cur_col, 0, "Motor 1", bgcolor=color.new(color.black, 40), text_color=color.white)
        table.cell(info_tab, cur_col, 1, str.tostring(p_gamma_val, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 2, str.tostring(v_gamma_val, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 3, str.tostring(atr_mult, "#.#####"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 4, str.tostring(atr_per_1, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 5, extra_layer_conn, bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 6, "Aktif", bgcolor=color.new(color.green, 70), text_color=c_txt)
        cur_col := cur_col + 1
    
    if show_m2
        table.cell(info_tab, cur_col, 0, "Motor 2", bgcolor=color.new(color.black, 40), text_color=color.white)
        table.cell(info_tab, cur_col, 1, str.tostring(p_gamma_val_2, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 2, str.tostring(v_gamma_val_2, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 3, str.tostring(atr_mult_2, "#.#####"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 4, str.tostring(atr_per_2, "#.###"), bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 5, extra_layer_conn_2, bgcolor=color.new(color.gray, 90), text_color=c_txt)
        table.cell(info_tab, cur_col, 6, "Aktif", bgcolor=color.new(color.green, 70), text_color=c_txt)

// --- CROSSOVER SCANNING EXECUTION ---
var float m1_1m_p_idx = 0.0, var float m1_1m_p_dir = 0.0, var float m1_1m_p_bar = 0.0
var float m1_1m_v_idx = 0.0, var float m1_1m_v_dir = 0.0, var float m1_1m_v_bar = 0.0
var float m1_1m_cur_idx = 0.0

var float m1_3m_p_idx = 0.0, var float m1_3m_p_dir = 0.0, var float m1_3m_p_bar = 0.0
var float m1_3m_v_idx = 0.0, var float m1_3m_v_dir = 0.0, var float m1_3m_v_bar = 0.0
var float m1_3m_cur_idx = 0.0

var float m1_5m_p_idx = 0.0, var float m1_5m_p_dir = 0.0, var float m1_5m_p_bar = 0.0
var float m1_5m_v_idx = 0.0, var float m1_5m_v_dir = 0.0, var float m1_5m_v_bar = 0.0
var float m1_5m_cur_idx = 0.0

if enable_cr
    [i1_p, d1_p, b1_p, i1_v, d1_v, b1_v, c1] = request.security(syminfo.tickerid, "1", f_m1_crossover_scanner())
    m1_1m_p_idx := i1_p, m1_1m_p_dir := d1_p, m1_1m_p_bar := b1_p
    m1_1m_v_idx := i1_v, m1_1m_v_dir := d1_v, m1_1m_v_bar := b1_v
    m1_1m_cur_idx := c1

    [i3_p, d3_p, b3_p, i3_v, d3_v, b3_v, c3] = request.security(syminfo.tickerid, "3", f_m1_crossover_scanner())
    m1_3m_p_idx := i3_p, m1_3m_p_dir := d3_p, m1_3m_p_bar := b3_p
    m1_3m_v_idx := i3_v, m1_3m_v_dir := d3_v, m1_3m_v_bar := b3_v
    m1_3m_cur_idx := c3

    [i5_p, d5_p, b5_p, i5_v, d5_v, b5_v, c5] = request.security(syminfo.tickerid, "5", f_m1_crossover_scanner())
    m1_5m_p_idx := i5_p, m1_5m_p_dir := d5_p, m1_5m_p_bar := b5_p
    m1_5m_v_idx := i5_v, m1_5m_v_dir := d5_v, m1_5m_v_bar := b5_v
    m1_5m_cur_idx := c5

// --- CROSSOVER TABLE ---
if enable_cr and barstate.islast
    cpos = cr_table_pos == "Top Right" ? position.top_right : cr_table_pos == "Bottom Right" ? position.bottom_right : cr_table_pos == "Top Left" ? position.top_left : cr_table_pos == "Bottom Left" ? position.bottom_left : position.middle_right
    var table cr_tab = table.new(cpos, 4, 7, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)
    c_bg = color.new(color.black, 40), c_txt = color.white

    table.cell(cr_tab, 0, 0, "TF", bgcolor=c_bg, text_color=color.yellow)
    table.cell(cr_tab, 1, 0, "Katman", bgcolor=c_bg, text_color=color.yellow)
    table.cell(cr_tab, 2, 0, "Yön", bgcolor=c_bg, text_color=color.yellow)
    table.cell(cr_tab, 3, 0, "Bar Önce", bgcolor=c_bg, text_color=color.yellow)

    f_fill_cr_row(cr_tab, 1, "1m P", m1_1m_p_idx, m1_1m_p_dir, m1_1m_p_bar, m1_1m_cur_idx)
    f_fill_cr_row(cr_tab, 2, "1m V", m1_1m_v_idx, m1_1m_v_dir, m1_1m_v_bar, m1_1m_cur_idx)
    f_fill_cr_row(cr_tab, 3, "3m P", m1_3m_p_idx, m1_3m_p_dir, m1_3m_p_bar, m1_3m_cur_idx)
    f_fill_cr_row(cr_tab, 4, "3m V", m1_3m_v_idx, m1_3m_v_dir, m1_3m_v_bar, m1_3m_cur_idx)
    f_fill_cr_row(cr_tab, 5, "5m P", m1_5m_p_idx, m1_5m_p_dir, m1_5m_p_bar, m1_5m_cur_idx)
    f_fill_cr_row(cr_tab, 6, "5m V", m1_5m_v_idx, m1_5m_v_dir, m1_5m_v_bar, m1_5m_cur_idx)


// Labels (Shared)
var label lp = na, var label lv = na
if barstate.islast
    int p_idx_label = settled_p_idx, int v_idx_label = settled_v_idx
    if not na(p_idx_label)
        int h_off = math.max(0, math.min(4999, bar_index - p_idx_label))
        if na(lp)
            lp := label.new(p_idx_label, eff_h_anc[h_off], "⚓ Tepe", color=color.red, textcolor=color.white, style=label.style_label_down)
        else
            label.set_xy(lp, p_idx_label, eff_h_anc[h_off])
    if not na(v_idx_label)
        int v_off = math.max(0, math.min(4999, bar_index - v_idx_label))
        if na(lv)
            lv := label.new(v_idx_label, eff_l_anc[v_off], "⚓ Dip", color=color.green, textcolor=color.white, style=label.style_label_up)
        else
            label.set_xy(lv, v_idx_label, eff_l_anc[v_off])
