//@version=6
indicator("Volcanic Auto Peaks & Valleys v6", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- GRUPLAR / GROUPS ---
string GRP_AUTO = "⚓ Otomatik Çapa Ayarları / Auto Anchor Settings"
string GRP_M1   = "🚀 Motor 1 Ayarları / Engine 1 Settings"
string GRP_M2   = "🚀 Motor 2 Ayarları / Engine 2 Settings"
string GRP_VIS  = "🎨 Görsel Ayarlar / Visual Settings"
string GRP_TAB  = "📊 Tablo Ayarları / Table Settings"
string GRP_CR   = "🔄 Kırılım Kontrol Motoru / Crossover Engine"

// --- GİRDİLER / INPUTS ---
lb_mode        = input.string("Manuel", "Tarama Modu / Lookback Mode", options=["Manuel", "Otomatik (Hassasiyet)", "Global (Maksimum)", "Manuel (Tarih Seçimi)"], group=GRP_AUTO)
lb_sens        = input.int(1, "Otomatik Hassasiyet / Auto Sensitivity", minval=1, maxval=9, group=GRP_AUTO, tooltip="Otomatik modda ne kadar geriye bakılacağını ayarlar.")
auto_lookback  = input.int(81, "Manuel Tarama Mesafesi / Manual Lookback", minval=10, maxval=4990, group=GRP_AUTO)
auto_threshold = input.float(0.1, "Sabitleme Eşiği / Settle Threshold (x sz)", group=GRP_AUTO, tooltip="Fiyat filtreden bu kadar uzaklaşırsa çapa güncellenir.")
auto_prox_threshold = input.float(0.5, "Yaklaşma Eşiği / Proximity Threshold (%)", group=GRP_AUTO, tooltip="Fiyat filtreye bu kadar yaklaşırsa çapa güncellenir.")
p_time         = input.time(timestamp("2030-01-01"), "Tepe Çapa Zamanı / Peak Anchor Time", group=GRP_AUTO, confirm=true)
v_time         = input.time(timestamp("2030-01-01"), "Dip Çapa Zamanı / Valley Anchor Time", group=GRP_AUTO, confirm=true)

// --- MOTOR 1 GİRDİLERİ ---
show_m1          = input.bool(true, "Motor 1'i Aktifleştir / Enable Motor 1", group=GRP_M1)
p_gamma_val      = input.float(9.42477796076938, "Motor 1: Tepe Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M1)
v_gamma_val      = input.float(9.42477796076938, "Motor 1: Dip Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M1)
atr_mult         = input.float(3.1415926535897932, "Motor 1: ATR Çarpanı", options=[0.0000031415926535897932, 0.000031415926535897932, 0.00031415926535897932, 0.0031415926535897932, 0.031415926535897932, 0.31415926535897932, 3.1415926535897932, 31.415926535897932, 314.15926535897932, 3141.5926535897932], group=GRP_M1)
extra_layer_conn = input.string("ATR Çarpanı", "Motor 1: Ek Katman Bağlantısı", options=["ATR Çarpanı", "Gamma"], group=GRP_M1)
use_ha_m1        = input.bool(false, "Motor 1: Heikin Ashi Kullan / Use HA", group=GRP_M1)

// --- MOTOR 2 GİRDİLERİ ---
show_m2          = input.bool(true, "Motor 2'yi Aktifleştir / Enable Motor 2", group=GRP_M2)
p_gamma_val_2      = input.float(9.42477796076938, "Motor 2: Tepe Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M2)
v_gamma_val_2      = input.float(9.42477796076938, "Motor 2: Dip Gamma", options=[1.5707963267948966, 3.141592653589793, 4.71238898038469, 6.283185307179586, 7.853981633974483, 9.42477796076938, 10.995574287564276, 12.566370614359172, 14.137166941154069, 15.707963267948966, 17.27875959474386, 18.84955592153876, 20.420352248333657, 21.991148575128552, 23.561944901923447, 25.132741228718345, 26.703537555513243, 28.274333882308138, 29.845130209103033, 31.41592653589793, 47.12388980384689, 62.83185307179586, 78.53981633974483, 94.24777960769379, 109.95574287564276, 125.66370614359172, 141.3716694115407], group=GRP_M2)
atr_mult_2         = input.float(31.415926535897932, "Motor 2: ATR Çarpanı", options=[0.0000031415926535897932, 0.000031415926535897932, 0.00031415926535897932, 0.0031415926535897932, 0.031415926535897932, 0.31415926535897932, 3.1415926535897932, 31.415926535897932, 314.15926535897932, 3141.5926535897932], group=GRP_M2)
extra_layer_conn_2 = input.string("ATR Çarpanı", "Motor 2: Ek Katman Bağlantısı", options=["ATR Çarpanı", "Gamma"], group=GRP_M2)
use_ha_m2        = input.bool(false, "Motor 2: Heikin Ashi Kullan / Use HA", group=GRP_M2)

// --- ORTAK GÖRSEL AYARLAR ---
auto_atr       = input.bool(true, "Otomatik ATR Periyodu / Auto ATR Period", group=GRP_VIS)
atr_opt        = input.float(8.1, "Manuel ATR Periyodu / Manual ATR Period", minval=0.01, maxval=4990.0, step=0.1, group=GRP_VIS)
show_peak      = input.bool(true, "Tepe Filtresini Göster / Show Peak Filter", group=GRP_VIS)
show_valley    = input.bool(true, "Dip Filtresini Göster / Show Valley Filter", group=GRP_VIS)
filt_width     = input.int(2, "Çizgi Kalınlığı / Line Width", minval=1, maxval=5, group=GRP_VIS)

show_table     = input.bool(true, "Bilgi Tablosunu Göster / Show Info Table", group=GRP_TAB)
table_pos      = input.string("Top Right", "Tablo Konumu / Table Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=GRP_TAB)

// --- KIRILIM KONTROL GİRDİLERİ ---
enable_cr      = input.bool(true, "Kırılım Motorunu Aktifleştir / Enable Crossover Engine", group=GRP_CR)
show_cr_arrows = input.bool(true, "Kırılım Oklarını Göster / Show Crossover Arrows", group=GRP_CR)
cr_table_pos   = input.string("Bottom Left", "Kırılım Tablo Konumu", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left", "Middle Right"], group=GRP_CR)

// --- YARDIMCI FONKSİYONLAR / HELPERS ---
f_kama_atr(float src, float n) =>
    float n_eff = math.max(0.01, n)
    int n_i = int(math.floor(n_eff))
    float frac = n_eff - n_i
    
    // Volatility calculation without a loop
    // Note: ta.sma must be called on every bar to maintain buffers
    float v_diff = math.abs(src - nz(src[1], src))
    int length = math.max(1, n_i)
    float vol_sum = ta.sma(v_diff, length) * length
    
    float vol = vol_sum
    if frac > 0
        vol := vol + math.abs(nz(src[n_i], src) - nz(src[n_i+1], src)) * frac
    
    // Direction calculation with interpolation
    float val_n = n_i == 0 ? src : (frac == 0 ? nz(src[n_i], src) : nz(src[n_i], src) * (1.0 - frac) + nz(src[n_i+1], src) * frac)
    float dir = math.abs(src - val_n)
    
    float er = vol == 0 ? 0 : math.min(1.0, dir / vol)
    
    // Adaptive smoothing limits to allow "faster" response for small n
    float fast_alpha = 2.0 / (math.max(1.0, math.min(2.0, n_eff)) + 1.0)
    float slow_alpha = 2.0 / 31.0
    
    float sc = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    
    // For periods below 1, scale the resulting value to represent fractional range
    n < 1.0 ? kama * n : kama

type FiltState
    float rfilt = na

method upd_filt(FiltState s, float h, float l, float r, float init_val, bool reset) =>
    if reset or na(s.rfilt)
        s.rfilt := init_val
    else
        if h - r > s.rfilt
            s.rfilt := h - r
        if l + r < s.rfilt
            s.rfilt := l + r
    s.rfilt

f_get_settled_idx(bool is_peak, int lb_mode_idx, int lb_val, float prev_f, float sz_val, int prev_settled, float h_src, float l_src, float c_src, int hb_49, int lb_49, int hb_a, int lb_a) =>
    int off = lb_mode_idx == 0 ? (is_peak ? hb_49 : lb_49) : (is_peak ? hb_a : lb_a)
    int raw_ext_idx = bar_index + off
    int res_idx = prev_settled
    if na(prev_settled) or (bar_index - prev_settled > lb_val)
        res_idx := raw_ext_idx
    else
        float dist_pct = not na(prev_f) ? math.abs(c_src - prev_f) / prev_f * 100 : na
        bool prox_reset = not na(dist_pct) and dist_pct <= auto_prox_threshold
        bool threshold_reset = not na(prev_f) and not na(sz_val) and math.abs(c_src - prev_f) > auto_threshold * sz_val
        if prox_reset or threshold_reset
            res_idx := raw_ext_idx
    res_idx

// --- CROSSOVER CORE LOGIC ---
f_get_cr_data(float m_val, float ex1, float ex2, float ex3, float ex4, float ex5, float ex6, float ex7) =>
    float res_idx = 0.0 // 1 to 7
    float res_dir = 0.0 // 1: Up, -1: Down

    // Check for crossovers. main filter (m_val) crosses others.
    // Divergence check: Previous values must be different to avoid anchor overlap signal
    bool div1 = nz(m_val[1]) != nz(ex1[1])
    bool div2 = nz(m_val[1]) != nz(ex2[1])
    bool div3 = nz(m_val[1]) != nz(ex3[1])
    bool div4 = nz(m_val[1]) != nz(ex4[1])
    bool div5 = nz(m_val[1]) != nz(ex5[1])
    bool div6 = nz(m_val[1]) != nz(ex6[1])
    bool div7 = nz(m_val[1]) != nz(ex7[1])

    if ta.crossunder(m_val, ex7) and div7
        res_idx := 7.0, res_dir := -1.0
    else if ta.crossover(m_val, ex7) and div7
        res_idx := 7.0, res_dir := 1.0
    else if ta.crossunder(m_val, ex6) and div6
        res_idx := 6.0, res_dir := -1.0
    else if ta.crossover(m_val, ex6) and div6
        res_idx := 6.0, res_dir := 1.0
    else if ta.crossunder(m_val, ex5) and div5
        res_idx := 5.0, res_dir := -1.0
    else if ta.crossover(m_val, ex5) and div5
        res_idx := 5.0, res_dir := 1.0
    else if ta.crossunder(m_val, ex4) and div4
        res_idx := 4.0, res_dir := -1.0
    else if ta.crossover(m_val, ex4) and div4
        res_idx := 4.0, res_dir := 1.0
    else if ta.crossunder(m_val, ex3) and div3
        res_idx := 3.0, res_dir := -1.0
    else if ta.crossover(m_val, ex3) and div3
        res_idx := 3.0, res_dir := 1.0
    else if ta.crossunder(m_val, ex2) and div2
        res_idx := 2.0, res_dir := -1.0
    else if ta.crossover(m_val, ex2) and div2
        res_idx := 2.0, res_dir := 1.0
    else if ta.crossunder(m_val, ex1) and div1
        res_idx := 1.0, res_dir := -1.0
    else if ta.crossover(m_val, ex1) and div1
        res_idx := 1.0, res_dir := 1.0

    [res_idx, res_dir]

f_m1_crossover_scanner() =>
    // This function replicates Motor 1 logic for scanning
    // 1. Inputs/Params (using global scope inputs is fine if called within security)

    // 2. Price/TR
    t_h = high, t_l = low, t_c = close
    t_tr = ta.tr(true) // Scanning will use standard TR for consistency with Anchor logic

    // 3. Size Units (KAMA ATR)
    t_atr_per = math.min(4990.0, auto_atr ? (timeframe.in_seconds() / 60.0) * atr_mult : atr_opt)
    t_unit = f_kama_atr(t_tr, nz(t_atr_per, 8.1))

    t_unit_ex1 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10.0 : atr_mult)))
    t_unit_ex2 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 100.0 : atr_mult)))
    t_unit_ex3 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 1000.0 : atr_mult)))
    t_unit_ex4 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10000.0 : atr_mult)))
    t_unit_ex5 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 100000.0 : atr_mult)))
    t_unit_ex6 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 1000000.0 : atr_mult)))
    t_unit_ex7 = f_kama_atr(t_tr, math.min(4990.0, (timeframe.in_seconds() / 60.0) * (extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10000000.0 : atr_mult)))

    // 4. Gamma Params
    pg = p_gamma_val, vg = v_gamma_val
    pg_ex1 = extra_layer_conn == "Gamma" ? pg + 1.5707963267948966 : pg
    pg_ex2 = extra_layer_conn == "Gamma" ? pg + 3.1415926535897932 : pg
    pg_ex3 = extra_layer_conn == "Gamma" ? pg + 4.71238898038469 : pg
    pg_ex4 = extra_layer_conn == "Gamma" ? pg + 6.283185307179586 : pg
    pg_ex5 = extra_layer_conn == "Gamma" ? pg + 7.853981633974483 : pg
    pg_ex6 = extra_layer_conn == "Gamma" ? pg + 9.42477796076938 : pg
    pg_ex7 = extra_layer_conn == "Gamma" ? pg + 10.995574287564276 : pg

    vg_ex1 = extra_layer_conn == "Gamma" ? vg + 1.5707963267948966 : vg
    vg_ex2 = extra_layer_conn == "Gamma" ? vg + 3.1415926535897932 : vg
    vg_ex3 = extra_layer_conn == "Gamma" ? vg + 4.71238898038469 : vg
    vg_ex4 = extra_layer_conn == "Gamma" ? vg + 6.283185307179586 : vg
    vg_ex5 = extra_layer_conn == "Gamma" ? vg + 7.853981633974483 : vg
    vg_ex6 = extra_layer_conn == "Gamma" ? vg + 9.42477796076938 : vg
    vg_ex7 = extra_layer_conn == "Gamma" ? vg + 10.995574287564276 : vg

    // 5. Anchor Calculation (Standard Prices)
    int lb_val = lb_mode == "Global (Maksimum)" ? 4990 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 144 : auto_lookback
    int eff_lb = math.min(math.max(1, lb_val), bar_index + 1)

    // We need to maintain state inside security, so we use var
    var int s_p_idx = na, var int s_v_idx = na
    var float l_f_p = na, var float l_f_v = na

    hb_49 = ta.highestbars(t_h, 4990), lb_49 = ta.lowestbars(t_l, 4990)
    hb_a = ta.highestbars(t_h, eff_lb), lb_a = ta.lowestbars(t_l, eff_lb)

    lb_idx = lb_mode == "Global (Maksimum)" ? 0 : 1

    // Manual calculation of range within security context
    is_r = (lb_mode == "Global (Maksimum)") or (lb_mode == "Manuel (Tarih Seçimi)") or (timenow - time < (lb_val + 500) * timeframe.in_seconds() * 1000)

    if is_r
        s_p_idx := lb_mode == "Manuel (Tarih Seçimi)" ? ta.valuewhen(time <= p_time, bar_index, 0) : f_get_settled_idx(true, lb_idx, lb_val, l_f_p, t_unit * pg, s_p_idx, t_h, t_l, t_c, hb_49, lb_49, hb_a, lb_a)
        s_v_idx := lb_mode == "Manuel (Tarih Seçimi)" ? ta.valuewhen(time <= v_time, bar_index, 0) : f_get_settled_idx(false, lb_idx, lb_val, l_f_v, t_unit * vg, s_v_idx, t_h, t_l, t_c, hb_49, lb_49, hb_a, lb_a)

    // 6. Filter Updates
    var FiltState fs_p = FiltState.new(), var FiltState fs_v = FiltState.new()
    var FiltState fs_p1 = FiltState.new(), var FiltState fs_v1 = FiltState.new()
    var FiltState fs_p2 = FiltState.new(), var FiltState fs_v2 = FiltState.new()
    var FiltState fs_p3 = FiltState.new(), var FiltState fs_v3 = FiltState.new()
    var FiltState fs_p4 = FiltState.new(), var FiltState fs_v4 = FiltState.new()
    var FiltState fs_p5 = FiltState.new(), var FiltState fs_v5 = FiltState.new()
    var FiltState fs_p6 = FiltState.new(), var FiltState fs_v6 = FiltState.new()
    var FiltState fs_p7 = FiltState.new(), var FiltState fs_v7 = FiltState.new()

    is_p_anc = (bar_index == s_p_idx) or (ta.change(s_p_idx) != 0)
    is_v_anc = (bar_index == s_v_idx) or (ta.change(s_v_idx) != 0)

    i_p = t_h[math.max(0, bar_index - nz(s_p_idx, bar_index))]
    i_v = t_l[math.max(0, bar_index - nz(s_v_idx, bar_index))]

    l_f_p := fs_p.upd_filt(t_h, t_l, t_unit * pg, i_p, is_p_anc)
    l_f_v := fs_v.upd_filt(t_h, t_l, t_unit * vg, i_v, is_v_anc)

    f_p1 = fs_p1.upd_filt(t_h, t_l, t_unit_ex1 * pg_ex1, i_p, is_p_anc)
    f_v1 = fs_v1.upd_filt(t_h, t_l, t_unit_ex1 * vg_ex1, i_v, is_v_anc)
    f_p2 = fs_p2.upd_filt(t_h, t_l, t_unit_ex2 * pg_ex2, i_p, is_p_anc)
    f_v2 = fs_v2.upd_filt(t_h, t_l, t_unit_ex2 * vg_ex2, i_v, is_v_anc)
    f_p3 = fs_p3.upd_filt(t_h, t_l, t_unit_ex3 * pg_ex3, i_p, is_p_anc)
    f_v3 = fs_v3.upd_filt(t_h, t_l, t_unit_ex3 * vg_ex3, i_v, is_v_anc)
    f_p4 = fs_p4.upd_filt(t_h, t_l, t_unit_ex4 * pg_ex4, i_p, is_p_anc)
    f_v4 = fs_v4.upd_filt(t_h, t_l, t_unit_ex4 * vg_ex4, i_v, is_v_anc)
    f_p5 = fs_p5.upd_filt(t_h, t_l, t_unit_ex5 * pg_ex5, i_p, is_p_anc)
    f_v5 = fs_v5.upd_filt(t_h, t_l, t_unit_ex5 * vg_ex5, i_v, is_v_anc)
    f_p6 = fs_p6.upd_filt(t_h, t_l, t_unit_ex6 * pg_ex6, i_p, is_p_anc)
    f_v6 = fs_v6.upd_filt(t_h, t_l, t_unit_ex6 * vg_ex6, i_v, is_v_anc)
    f_p7 = fs_p7.upd_filt(t_h, t_l, t_unit_ex7 * pg_ex7, i_p, is_p_anc)
    f_v7 = fs_v7.upd_filt(t_h, t_l, t_unit_ex7 * vg_ex7, i_v, is_v_anc)

    // 7. Detection
    [p_cr_idx, p_cr_dir] = f_get_cr_data(l_f_p, f_p1, f_p2, f_p3, f_p4, f_p5, f_p6, f_p7)
    [v_cr_idx, v_cr_dir] = f_get_cr_data(l_f_v, f_v1, f_v2, f_v3, f_v4, f_v5, f_v6, f_v7)

    // Find how many bars ago the last crossover happened
    // We'll return the index, direction and some identifier
    // For simplicity, let's just return the last event data
    var float last_p_idx = 0.0, var float last_p_dir = 0.0, var int last_p_bar = 0
    var float last_v_idx = 0.0, var float last_v_dir = 0.0, var int last_v_bar = 0

    if p_cr_idx > 0
        last_p_idx := p_cr_idx, last_p_dir := p_cr_dir, last_p_bar := bar_index
    if v_cr_idx > 0
        last_v_idx := v_cr_idx, last_v_dir := v_cr_dir, last_v_bar := bar_index

    [last_p_idx, last_p_dir, float(last_p_bar), last_v_idx, last_v_dir, float(last_v_bar), float(bar_index)]

f_fill_cr_row(table t, int r, string tf_str, float idx, float dir, float b_idx, float cur_idx) =>
    table.cell(t, 0, r, tf_str, bgcolor=color.new(color.gray, 80), text_color=color.white)
    if idx > 0
        // Calculate bars ago based on native timeframe indices
        b_ago = int(cur_idx - b_idx)
        table.cell(t, 1, r, "L" + str.tostring(idx, "#"), bgcolor=color.new(color.gray, 90), text_color=color.white)
        table.cell(t, 2, r, dir > 0 ? "↓" : "↑", bgcolor=color.new(color.gray, 90), text_color=dir > 0 ? color.red : color.green)
        table.cell(t, 3, r, str.tostring(b_ago), bgcolor=color.new(color.gray, 90), text_color=color.white)
    else
        table.cell(t, 1, r, "-", bgcolor=color.new(color.gray, 90), text_color=color.gray)
        table.cell(t, 2, r, "-", bgcolor=color.new(color.gray, 90), text_color=color.gray)
        table.cell(t, 3, r, "-", bgcolor=color.new(color.gray, 90), text_color=color.gray)

// --- HESAPLAMA AKIŞI / CALCULATION FLOW ---
// Anchor Prices (Always Standard)
eff_h_anc = high
eff_l_anc = low
eff_c_anc = close

// Heikin Ashi Calculation
var float haOpen = na
haClose = (open + high + low + close) / 4
haOpen := na(haOpen[1]) ? (open + close) / 2 : (haOpen[1] + haClose[1]) / 2
haHigh = math.max(high, math.max(haOpen, haClose))
haLow  = math.min(low,  math.min(haOpen, haClose))

// Motor-specific Prices
eff_h_m1 = use_ha_m1 ? haHigh : high
eff_l_m1 = use_ha_m1 ? haLow  : low
eff_c_m1 = use_ha_m1 ? haClose : close

eff_h_m2 = use_ha_m2 ? haHigh : high
eff_l_m2 = use_ha_m2 ? haLow  : low
eff_c_m2 = use_ha_m2 ? haClose : close

// True Ranges
float tr_std = ta.tr(true)
float tr_ha  = math.max(haHigh - haLow, math.max(math.abs(haHigh - haClose[1]), math.abs(haLow - haClose[1])))
float tr_m1  = use_ha_m1 ? tr_ha : tr_std
float tr_m2  = use_ha_m2 ? tr_ha : tr_std

int lb_input_val = lb_mode == "Global (Maksimum)" ? 4990 : lb_mode == "Otomatik (Hassasiyet)" ? lb_sens * 144 : auto_lookback

// Calculation of is_in_range without last_bar_index dependency
// Using timenow to estimate the current bar position relative to history
bool is_in_range = (lb_mode == "Global (Maksimum)") or 
                  (lb_mode == "Manuel (Tarih Seçimi)") or
                  (timenow - time < (lb_input_val + 500) * timeframe.in_seconds() * 1000)

// Engine 1 Parameters
float atr_per_1 = math.min(4990.0, auto_atr ? (timeframe.in_seconds() / 60.0) * atr_mult : atr_opt)
float cur_sz_unit_1_raw = f_kama_atr(tr_m1, nz(atr_per_1, 8.1))
float cur_sz_unit_1 = is_in_range ? cur_sz_unit_1_raw : 0.0

float atr_mult_ex_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex_1 := na

float atr_per_ex_1 = not na(atr_mult_ex_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex_1) : na
float cur_sz_unit_ex_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex_1, 8.1))
float cur_sz_unit_ex_1 = is_in_range and not na(atr_per_ex_1) ? cur_sz_unit_ex_1_raw : na

// Motor 1: 2nd Extra Peak Parameters
float atr_mult_ex2_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 100.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex2_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex2_1 := na
float atr_per_ex2_1 = not na(atr_mult_ex2_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex2_1) : na
float cur_sz_unit_ex2_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex2_1, 8.1))
float cur_sz_unit_ex2_1 = is_in_range and not na(atr_per_ex2_1) ? cur_sz_unit_ex2_1_raw : na

// Motor 1: 3rd Extra Peak Parameters
float atr_mult_ex3_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 1000.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex3_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex3_1 := na
float atr_per_ex3_1 = not na(atr_mult_ex3_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex3_1) : na
float cur_sz_unit_ex3_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex3_1, 8.1))
float cur_sz_unit_ex3_1 = is_in_range and not na(atr_per_ex3_1) ? cur_sz_unit_ex3_1_raw : na

// Motor 1: 4th Extra Peak Parameters
float atr_mult_ex4_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10000.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex4_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex4_1 := na
float atr_per_ex4_1 = not na(atr_mult_ex4_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex4_1) : na
float cur_sz_unit_ex4_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex4_1, 8.1))
float cur_sz_unit_ex4_1 = is_in_range and not na(atr_per_ex4_1) ? cur_sz_unit_ex4_1_raw : na

// Motor 1: 5th Extra Peak Parameters
float atr_mult_ex5_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 100000.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex5_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex5_1 := na
float atr_per_ex5_1 = not na(atr_mult_ex5_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex5_1) : na
float cur_sz_unit_ex5_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex5_1, 8.1))
float cur_sz_unit_ex5_1 = is_in_range and not na(atr_per_ex5_1) ? cur_sz_unit_ex5_1_raw : na

// Motor 1: 6th Extra Peak Parameters
float atr_mult_ex6_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 1000000.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex6_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex6_1 := na
float atr_per_ex6_1 = not na(atr_mult_ex6_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex6_1) : na
float cur_sz_unit_ex6_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex6_1, 8.1))
float cur_sz_unit_ex6_1 = is_in_range and not na(atr_per_ex6_1) ? cur_sz_unit_ex6_1_raw : na

// Motor 1: 7th Extra Peak Parameters
float atr_mult_ex7_1 = extra_layer_conn == "ATR Çarpanı" ? atr_mult * 10000000.0 : atr_mult
if extra_layer_conn == "ATR Çarpanı" and (atr_mult_ex7_1 > 3141.5926535897932 + 1.0)
    atr_mult_ex7_1 := na
float atr_per_ex7_1 = not na(atr_mult_ex7_1) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex7_1) : na
float cur_sz_unit_ex7_1_raw = f_kama_atr(tr_m1, nz(atr_per_ex7_1, 8.1))
float cur_sz_unit_ex7_1 = is_in_range and not na(atr_per_ex7_1) ? cur_sz_unit_ex7_1_raw : na

float p_gamma_ex_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 1.5707963267948966 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex_1 > 141.3716694115407 + 0.1)
    p_gamma_ex_1 := na
float p_gamma_ex2_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 3.1415926535897932 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex2_1 > 141.3716694115407 + 0.1)
    p_gamma_ex2_1 := na
float p_gamma_ex3_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 4.71238898038469 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex3_1 > 141.3716694115407 + 0.1)
    p_gamma_ex3_1 := na
float p_gamma_ex4_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 6.283185307179586 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex4_1 > 141.3716694115407 + 0.1)
    p_gamma_ex4_1 := na
float p_gamma_ex5_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 7.853981633974483 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex5_1 > 141.3716694115407 + 0.1)
    p_gamma_ex5_1 := na
float p_gamma_ex6_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 9.42477796076938 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex6_1 > 141.3716694115407 + 0.1)
    p_gamma_ex6_1 := na
float p_gamma_ex7_1 = extra_layer_conn == "Gamma" ? p_gamma_val + 10.995574287564276 : p_gamma_val
if extra_layer_conn == "Gamma" and (p_gamma_ex7_1 > 141.3716694115407 + 0.1)
    p_gamma_ex7_1 := na
float v_gamma_ex_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 1.5707963267948966 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex_1 > 141.3716694115407 + 0.1)
    v_gamma_ex_1 := na
float v_gamma_ex2_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 3.1415926535897932 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex2_1 > 141.3716694115407 + 0.1)
    v_gamma_ex2_1 := na
float v_gamma_ex3_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 4.71238898038469 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex3_1 > 141.3716694115407 + 0.1)
    v_gamma_ex3_1 := na
float v_gamma_ex4_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 6.283185307179586 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex4_1 > 141.3716694115407 + 0.1)
    v_gamma_ex4_1 := na
float v_gamma_ex5_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 7.853981633974483 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex5_1 > 141.3716694115407 + 0.1)
    v_gamma_ex5_1 := na
float v_gamma_ex6_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 9.42477796076938 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex6_1 > 141.3716694115407 + 0.1)
    v_gamma_ex6_1 := na
float v_gamma_ex7_1 = extra_layer_conn == "Gamma" ? v_gamma_val + 10.995574287564276 : v_gamma_val
if extra_layer_conn == "Gamma" and (v_gamma_ex7_1 > 141.3716694115407 + 0.1)
    v_gamma_ex7_1 := na

// Engine 2 Parameters
float atr_per_2 = math.min(4990.0, auto_atr ? (timeframe.in_seconds() / 60.0) * atr_mult_2 : atr_opt)
float cur_sz_unit_2_raw = f_kama_atr(tr_m2, nz(atr_per_2, 8.1))
float cur_sz_unit_2 = is_in_range ? cur_sz_unit_2_raw : 0.0

float atr_mult_ex_2 = extra_layer_conn_2 == "ATR Çarpanı" ? atr_mult_2 * 10.0 : atr_mult_2
if extra_layer_conn_2 == "ATR Çarpanı" and (atr_mult_ex_2 > 3141.5926535897932 + 1.0)
    atr_mult_ex_2 := na

float atr_per_ex_2 = not na(atr_mult_ex_2) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex_2) : na
float cur_sz_unit_ex_2_raw = f_kama_atr(tr_m2, nz(atr_per_ex_2, 8.1))
float cur_sz_unit_ex_2 = is_in_range and not na(atr_per_ex_2) ? cur_sz_unit_ex_2_raw : na

// Motor 2: 2nd Extra Parameters
float atr_mult_ex2_2 = extra_layer_conn_2 == "ATR Çarpanı" ? atr_mult_2 * 100.0 : atr_mult_2
if extra_layer_conn_2 == "ATR Çarpanı" and (atr_mult_ex2_2 > 3141.5926535897932 + 1.0)
    atr_mult_ex2_2 := na
float atr_per_ex2_2 = not na(atr_mult_ex2_2) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex2_2) : na
float cur_sz_unit_ex2_2_raw = f_kama_atr(tr_m2, nz(atr_per_ex2_2, 8.1))
float cur_sz_unit_ex2_2 = is_in_range and not na(atr_per_ex2_2) ? cur_sz_unit_ex2_2_raw : na

// Motor 2: 3rd Extra Parameters
float atr_mult_ex3_2 = extra_layer_conn_2 == "ATR Çarpanı" ? atr_mult_2 * 1000.0 : atr_mult_2
if extra_layer_conn_2 == "ATR Çarpanı" and (atr_mult_ex3_2 > 3141.5926535897932 + 1.0)
    atr_mult_ex3_2 := na
float atr_per_ex3_2 = not na(atr_mult_ex3_2) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex3_2) : na
float cur_sz_unit_ex3_2_raw = f_kama_atr(tr_m2, nz(atr_per_ex3_2, 8.1))
float cur_sz_unit_ex3_2 = is_in_range and not na(atr_per_ex3_2) ? cur_sz_unit_ex3_2_raw : na

// Motor 2: 4th Extra Parameters
float atr_mult_ex4_2 = extra_layer_conn_2 == "ATR Çarpanı" ? atr_mult_2 * 10000.0 : atr_mult_2
if extra_layer_conn_2 == "ATR Çarpanı" and (atr_mult_ex4_2 > 3141.5926535897932 + 1.0)
    atr_mult_ex4_2 := na
float atr_per_ex4_2 = not na(atr_mult_ex4_2) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex4_2) : na
float cur_sz_unit_ex4_2_raw = f_kama_atr(tr_m2, nz(atr_per_ex4_2, 8.1))
float cur_sz_unit_ex4_2 = is_in_range and not na(atr_per_ex4_2) ? cur_sz_unit_ex4_2_raw : na

// Motor 2: 5th Extra Parameters
float atr_mult_ex5_2 = extra_layer_conn_2 == "ATR Çarpanı" ? atr_mult_2 * 100000.0 : atr_mult_2
if extra_layer_conn_2 == "ATR Çarpanı" and (atr_mult_ex5_2 > 3141.5926535897932 + 1.0)
    atr_mult_ex5_2 := na
float atr_per_ex5_2 = not na(atr_mult_ex5_2) ? math.min(4990.0, (timeframe.in_seconds() / 60.0) * atr_mult_ex5_2) : na
float cur_sz_unit_ex5_2_raw = f_kama_atr(tr_m2, nz(atr_per_ex5_2, 8.1))
float cur_sz_unit_ex5_2 = is_in_range and not na(atr_per_ex5_2) ? cur_sz_unit_ex5_2_raw : na

float p_gamma_ex_2 = extra_layer_conn_2 == "Gamma" ? p_gamma_val_2 + 1.5707963267948966 : p_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (p_gamma_ex_2 > 141.3716694115407 + 0.1)
    p_gamma_ex_2 := na
float p_gamma_ex2_2 = extra_layer_conn_2 == "Gamma" ? p_gamma_val_2 + 3.1415926535897932 : p_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (p_gamma_ex2_2 > 141.3716694115407 + 0.1)
    p_gamma_ex2_2 := na
float p_gamma_ex3_2 = extra_layer_conn_2 == "Gamma" ? p_gamma_val_2 + 4.71238898038469 : p_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (p_gamma_ex3_2 > 141.3716694115407 + 0.1)
    p_gamma_ex3_2 := na
float p_gamma_ex4_2 = extra_layer_conn_2 == "Gamma" ? p_gamma_val_2 + 6.283185307179586 : p_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (p_gamma_ex4_2 > 141.3716694115407 + 0.1)
    p_gamma_ex4_2 := na
float p_gamma_ex5_2 = extra_layer_conn_2 == "Gamma" ? p_gamma_val_2 + 7.853981633974483 : p_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (p_gamma_ex5_2 > 141.3716694115407 + 0.1)
    p_gamma_ex5_2 := na

float v_gamma_ex_2 = extra_layer_conn_2 == "Gamma" ? v_gamma_val_2 + 1.5707963267948966 : v_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (v_gamma_ex_2 > 141.3716694115407 + 0.1)
    v_gamma_ex_2 := na
float v_gamma_ex2_2 = extra_layer_conn_2 == "Gamma" ? v_gamma_val_2 + 3.1415926535897932 : v_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (v_gamma_ex2_2 > 141.3716694115407 + 0.1)
    v_gamma_ex2_2 := na
float v_gamma_ex3_2 = extra_layer_conn_2 == "Gamma" ? v_gamma_val_2 + 4.71238898038469 : v_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (v_gamma_ex3_2 > 141.3716694115407 + 0.1)
    v_gamma_ex3_2 := na
float v_gamma_ex4_2 = extra_layer_conn_2 == "Gamma" ? v_gamma_val_2 + 6.283185307179586 : v_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (v_gamma_ex4_2 > 141.3716694115407 + 0.1)
    v_gamma_ex4_2 := na
float v_gamma_ex5_2 = extra_layer_conn_2 == "Gamma" ? v_gamma_val_2 + 7.853981633974483 : v_gamma_val_2
if extra_layer_conn_2 == "Gamma" and (v_gamma_ex5_2 > 141.3716694115407 + 0.1)
    v_gamma_ex5_2 := na

max_bars_back(cur_sz_unit_1, 5000)
max_bars_back(cur_sz_unit_ex_1, 5000)
max_bars_back(cur_sz_unit_ex2_1, 5000)
float cur_sz_unit_ex2_v1_raw = f_kama_atr(tr_m1, nz(atr_per_ex2_1, 8.1))
float cur_sz_unit_ex2_v1 = is_in_range and not na(atr_per_ex2_1) ? cur_sz_unit_ex2_v1_raw : na
max_bars_back(cur_sz_unit_ex2_v1, 5000)
max_bars_back(cur_sz_unit_ex3_1, 5000)
max_bars_back(cur_sz_unit_ex4_1, 5000)
max_bars_back(cur_sz_unit_ex5_1, 5000)
max_bars_back(cur_sz_unit_ex6_1, 5000)
max_bars_back(cur_sz_unit_ex7_1, 5000)
max_bars_back(cur_sz_unit_2, 5000)
max_bars_back(cur_sz_unit_ex_2, 5000)
max_bars_back(cur_sz_unit_ex2_2, 5000)
max_bars_back(cur_sz_unit_ex3_2, 5000)
max_bars_back(cur_sz_unit_ex4_2, 5000)
max_bars_back(cur_sz_unit_ex5_2, 5000)
max_bars_back(high, 5000)
max_bars_back(low, 5000)
max_bars_back(close, 5000)
max_bars_back(time, 5000)
max_bars_back(eff_h_anc, 5000)
max_bars_back(eff_l_anc, 5000)
max_bars_back(eff_c_anc, 5000)
max_bars_back(eff_h_m1, 5000)
max_bars_back(eff_l_m1, 5000)
max_bars_back(eff_c_m1, 5000)
max_bars_back(eff_h_m2, 5000)
max_bars_back(eff_l_m2, 5000)
max_bars_back(eff_c_m2, 5000)

// 3. Anchor & Lookback State (Shared)
int lb_input = lb_input_val
int eff_lb = math.min(math.max(1, lb_input), bar_index + 1)
f_dyn_hb(src, len) => ta.highestbars(src, math.min(len, bar_index + 1))
f_dyn_lb(src, len) => ta.lowestbars(src, math.min(len, bar_index + 1))

hb_4990 = f_dyn_hb(eff_h_anc, 4990), lb_4990 = f_dyn_lb(eff_l_anc, 4990)
hb_auto = f_dyn_hb(eff_h_anc, lb_input), lb_auto = f_dyn_lb(eff_l_anc, lb_input)

// Final Sizes for Engines
float cur_p_sz_1 = cur_sz_unit_1 * p_gamma_val
float cur_v_sz_1 = cur_sz_unit_1 * v_gamma_val
float cur_p_sz_2 = cur_sz_unit_2 * p_gamma_val_2
float cur_v_sz_2 = cur_sz_unit_2 * v_gamma_val_2

// Anchor Indices (Shared)
var int settled_p_idx = na
var int settled_v_idx = na
var float last_f_p_1 = na
var float last_f_v_1 = na


int lb_mode_idx = lb_mode == "Global (Maksimum)" ? 0 : 1
if is_in_range
    settled_p_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(true, lb_mode_idx, lb_input, last_f_p_1, cur_p_sz_1, settled_p_idx, eff_h_anc, eff_l_anc, eff_c_anc, hb_4990, lb_4990, hb_auto, lb_auto)
    settled_v_idx := lb_mode == "Manuel (Tarih Seçimi)" ? na : f_get_settled_idx(false, lb_mode_idx, lb_input, last_f_v_1, cur_v_sz_1, settled_v_idx, eff_h_anc, eff_l_anc, eff_c_anc, hb_4990, lb_4990, hb_auto, lb_auto)

if lb_mode == "Manuel (Tarih Seçimi)"
    settled_p_idx := ta.valuewhen(time <= p_time, bar_index, 0)
    settled_v_idx := ta.valuewhen(time <= v_time, bar_index, 0)

// 7. Filter States (8 Total)
var FiltState fs_p1 = FiltState.new(), fs_v1 = FiltState.new()
var FiltState fs_p1_ex = FiltState.new(), fs_v1_ex = FiltState.new()
var FiltState fs_p2 = FiltState.new(), fs_v2 = FiltState.new()
var FiltState fs_p2_ex = FiltState.new(), fs_v2_ex = FiltState.new()

is_p_anc = (bar_index == settled_p_idx) or (ta.change(settled_p_idx) != 0)
is_v_anc = (bar_index == settled_v_idx) or (ta.change(settled_v_idx) != 0)
float init_p_val_m1 = eff_h_m1[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
float init_v_val_m1 = eff_l_m1[math.max(0, bar_index - nz(settled_v_idx, bar_index))]
float init_p_val_m2 = eff_h_m2[math.max(0, bar_index - nz(settled_p_idx, bar_index))]
